ARCH = linux_gnu

F90C = mpif90

LPATH=/scratch/project_2017831/jlento/environments/my_gcc152_ec/view

# Flags for optimization, etc.
OPTIMIZATION = -O3 -fopenmp -ffast-math
OPENMP = 
DEBUG = -g  -fbacktrace  #-fcheck=all -fbacktrace   -finit-real=snan  #-DDEBUG
FIXED = -ffixed-form
PREPROCESS = -x f95-cpp-input  -D WITH_BZIP2 -D WITH_PNETCDF -DSILAM_MPI -D USE_PROJ6 
FFLAGS = $(OPTIMIZATION) $(DEBUG) $(TESTOPTIONS) $(INCLUDE) -ffree-line-length-none -mno-avx
INCLUDE = -I$(OBJDIR) -I/usr/include -I$(LPATH)/include

# netcdf install directory
NCDIR =
# grib api install directory
GRDIR =

# Libraries passed to ifort
SILAM_LIBS = 
# Libraries given as linker options
LFLAGS = -L$(LPATH)/lib  -L$(LPATH)/lib64 -Wl,-rpath=$(LPATH)/lib -Wl,-rpath=$(LPATH)/lib64 -fopenmp -llapack -lblas -llapack -leccodes  -leccodes_f90 -lnetcdff -lnetcdf -lpnetcdf -lbz2 -lproj
