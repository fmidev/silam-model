// FIX-SULF <55> DMS + NO3 = SO2 + HCHO + MEO2 + HNO3 : ARRZ(1.9d-13, -520d0); // k = 1.90E-13 exp(520/T) 1.09E-12

<56> C2O3 + NO = NO2 + MEO2 + RO2 : ARRZ(7.5d-12,-290.0d0); //k = 7.50E-12 exp(290/T) 1.98E-11

<57> C2O3 + NO2 {+M} = PAN {+M}   : k3rd_iup_pow(3.28d-28, 6.87d0, 1.125d-11, 1.105d0, 0.3d0); {RH2018: IUPAC}
// Falloff: F=0.3; n=1.41, k(0) = 3.61E-28 (T/300)^-6.87, k(inf) = 1.24E-11 (T/300)^-1.105 9.86E-12

<58> PAN {+M} = NO2 + C2O3 {+M}   : k3rd_iup_exp(1.1d-5, 0.0d0, 10100.0d0, 1.9d17, 0.0d0, 14100.0d0, 0.3d0);
// Falloff: F=0.3; n=1.41, k(0) = 1.10E-5 exp(-10100/T), k(inf) = 1.90E+17 exp(-14100/T) 4.31E-4

<59> PAN + hv = 0.6*NO2 + 0.6*C2O3 + 0.4*NO3 + 0.4*MEO2 + 0.4*RO2  : photoarr(pd_pan); // Photolysis 3.47E-7

<60> C2O3 + HO2 = 0.37*PACD + 0.13*AACD + 0.13*O3 + 0.5*OH + 0.5*MEO2 + 0.5*RO2 : ARRZ(3.14d-12,-580.0d0);
// k = 3.14E-12 exp(580/T) 2.20E-11 RH-NOTE: OLD SILAM-CB05 rate: ARRZ(5.2d-13,-980.0d0) ;

<61> C2O3 + RO2 = 0.3*AACD + 0.7*MEO2 + 1.7*RO2 : ARRZ(4.4d-13,-1070.0d0);
// k = 4.40E-13 exp(1070/T) 1.60E-11

<62> C2O3 + C2O3 = 2*MEO2 + 2*RO2 : ARRZ(2.9d-12,-500.0d0); // k = 2.90E-12 exp(500/T) 1.55E-11

