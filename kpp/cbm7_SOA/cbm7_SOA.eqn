                   + 0.014593 BVB1e0 + 0.012485 BVB1e1 + 0.048783 BVB1e2 + 0.08262 BVB1e3      : ARRZ(4.46d-15,960.0d0) * (1.0-SOA_b); {OLD: ARRZ(1.2d-15, 821.0d0) * (1.0-SOA_b);}
{109} NO3 + C5H8_2 = NO3 + C5H8_2
                   + 0.014593 BVB1e0 + 0.012485 BVB1e1 + 0.048783 BVB1e2 + 0.08262 BVB1e3      : 7.00d-12 * (1.0-SOA_b); {OLD: ARRZ(3.7d-12,-175.0d0) * (1.0-SOA_b);}

//NOTE: Added SESQ in the products since CB7 has them already in gas phase reactions! Rates unified with CB7-rates
//Since Shrivastava's mass yields for both high and low NOx cases are the same one can combine these cases:
{107}  OH + SESQ =  OH + SESQ + 0.0153 BVB1e0 + 0.0306 BVB1e1 + 0.153 BVB1e2 + 0.103836 BVB1e3        : 2.00E-10;
{108}  O3 + SESQ =  O3 + SESQ + 0.0153 BVB1e0 + 0.0306 BVB1e1 + 0.153 BVB1e2 + 0.103836 BVB1e3        : 1.20E-14; 
{109} NO3 + SESQ = NO3 + SESQ + 0.0153 BVB1e0 + 0.0306 BVB1e1 + 0.153 BVB1e2 + 0.103836 BVB1e3        : 1.90E-11;

{SOA aging}
   
{110} OH + AVB1e0 = {OH +} 1.075 AVB0                       : ASOA_aging {4.0E-11} ;
{111} OH + AVB1e1 = {OH +} 1.075 AVB1e0                     : ASOA_aging {4.0E-11} ;
{112} OH + AVB1e2 = {OH +} 1.075 AVB1e1                     : ASOA_aging {4.0E-11} ;
{113} OH + AVB1e3 = {OH +} 1.075 AVB1e2                     : ASOA_aging {4.0E-11} ;
{114} OH + AVB1e4 = {OH +} 1.075 AVB1e3                     : IVOC_aging {4.0E-11} ;
{115} OH + AVB1e5 = {OH +} 1.075 AVB1e4                     : IVOC_aging {4.0E-11} ;
{116} OH + AVB1e6 = {OH +} 1.075 AVB1e5                     : IVOC_aging {4.0E-11} ;
{117} OH + BVB1e0 = {OH +} 1.075 BVB0                       : BSOA_aging {4.0E-11} ;
{118} OH + BVB1e1 = {OH +} 1.075 BVB1e0                     : BSOA_aging {4.0E-11} ;
{119} OH + BVB1e2 = {OH +} 1.075 BVB1e1                     : BSOA_aging {4.0E-11} ;
{120} OH + BVB1e3 = {OH +} 1.075 BVB1e2                     : BSOA_aging {4.0E-11} ;

