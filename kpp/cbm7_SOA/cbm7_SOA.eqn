<64> CXO3 + NO2 = PANX : 1.19d0*k3rd_iup_pow(3.28d-28, 6.87d0, 1.125d-11, 1.105d0, 0.3d0); // 1.19 times the rate of C2O3+NO2
//k = k(ref) K, k(ref) = k(57), K = 1.19E+0, 8.28E-12

<65> PANX = NO2 + CXO3 : 1.19d0*k3rd_iup_exp(1.1d-5, 0.0d0, 10100.0d0, 1.9d17, 0.0d0, 14100.0d0, 0.3d0);
// k = k(ref) K, k(ref) = k(58), K = 1.19E+0, 3.62E-4

<66> PANX + OH = 0.5 ALD2 + NO2 : 3.00d-12;  // k = 3.00E-12 3.00E-12

<67> CXO3 + HO2 = 0.19*PACD + 0.06*AACD + 0.25*ALD2 + 0.06*O3 + 0.25*OH + 0.25*HO2 : ARRZ(3.14d-12,-580.0d0); // same rate as C2O3+HO2
// k = k(ref) K, k(ref) = k(60), K = 1.00E+0 2.20E-11

<68> CXO3 + RO2 = 0.35 ALD2 + 0.15 AACD + 0.35 HO2 + RO2 : ARRZ(4.4d-13,-1070.0d0); // same rate as C2O3+RO2
