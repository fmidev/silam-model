#EQUATIONS

{ CBM7 equations taken from the }
{ "Develop CB7 Chemical Mechanism for CAMx Ozone Modeling" Final Report by Greg Yarwood, Yuge Shi and Ross Beardsley }
{ Work Order No. 582-21-21802-020, Contract No. 582-19-90500, Tracking No. 2021-11, Task 6.2 }

// RH-NOTE: Check the equations that are in CB06 but not in CB7 (at least the NO3+O, NO3+O3, NO+NO2+H2O = 2*HONO, for strato)
// Table 3.
// The CB7 mechanism.
// No. Reactants and Products a, b Rate Constant Expression k 298 c, d

// The following variable changes where done, including some PAR's into different species:
// KET7  = KET+3.0*PAR;
// XPAR7 = XPAR+3.0*PAR;
// ROR7  = ROR+2.85*PAR;
// OLE7  = OLE+PAR;

<1> NO2 + hv = NO + O            : photoarr(pd_no2);         // Photolysis 6.30E-3

{R2: Note 3-body reaction. Include O2 in the reaction and leave M to the rate constant.}
<2> O2 + O {+ M} = O3 {+ M}      : k0_pow(6.0d-34, 2.6d0);   // k = 6.00E-34 (T/300)^-2.6 6.11E-34

<3> NO + O3 = NO2                : ARRZ(2.07d-12,1400.0d0);  // k = 2.07E-12 exp(-1400/T) 1.89E-14

<4> NO + O {+ M} = NO2           : k3rd_iup_pow(1.0d-31, 1.6d0, 5.0d-11, 0.3d0, 0.85d0); {RH2017: IUPAC}
// Falloff: F=0.85; n=0.84 k(0) = 1.00E-31 (T/300)^-1.6 k(inf) = 5.00E-11 (T/300)^-0.3 2.26E-12

<5> NO2 + O = NO                 : ARRZ(5.1d-12,-198.0d0); // k = 5.10E-12 exp(198/T) 9.91E-12

<6> NO2 + O {+ M} = NO3          : k3rd_iup_pow(1.3d-31, 1.5d0, 2.3d-11, -0.24d0, 0.6d0); {IUPAC}
// Falloff: F=0.6; n=1.03 k(0) = 1.30E-31 (T/300)^-1.5 k(inf) = 2.30E-11 (T/300)^0.24 2.09E-12

<7> O3 + O = 2*O2                : ARRZ(8.0d-12, 2060d0); // k = 8.00E-12 exp(-2060/T) 7.96E-15
// RH-NOTE: Remove from strato equations Eq: FR 121

<8> O3 + hv = O                  : photoarr(pd_o3); // Photolysis 3.33E-4

<9> O3 + hv = O1D                : photoarr(pd_o3_o1d); //Photolysis 8.78E-6

{R10: JPL, + M added *** important rate, note the N2 and O2 weights in rates. Including the last 1% into N2.}
{IUPAC2017, put M in reaction: k = arrz(0.79*2.15d-11, -110.0d0) + arrz(0.21*3.2d-11, -67.0d0) ;}
{JPL, also keep M:             k = arrz(0.79*2.15d-11, -110.0d0) + arrz(0.21*3.3d-11, -55.0d0) ;}
<10> O1D + M = O {+ M}           : arrz(0.79*2.15d-11, -110.0d0) + arrz(0.21*3.2d-11, -67.0d0);  //k = 2.23E-11 exp(115/T) 3.28E-11

<11> O1D + H2O = 2*OH            : 2.14E-10; // k = 2.14E-10 2.14E-10

<12> O3 + OH = HO2               : ARRZ(1.7d-12,940.0d0); // k = 1.70E-12 exp(-940/T) 7.25E-14

<13> O3 + HO2 = OH               : 2.03d-16*(temp_dp/300.0d0)**4.57 *exp(693.0d0/temp_dp); // k = 2.03E-16 (T/300)^4.57 exp(693/T) 2.01E-15

<14> OH + O = HO2                : ARRZ(2.4d-11, -110d0); // k = 2.40E-11 exp(110/T) 3.47E-11
//<14> OH + O = H {+O2}            : ARRZ(2.4d-11, -110d0); //RH-NOTE: here H explicitely

<15> HO2 + O = OH                : ARRZ(3.0d-11, -200d0); // JPL-rate, k = 3.00E-11 exp(200/T) 5.87E-11
//<15> HO2 + O = OH                : ARRZ(2.7d-11, -224d0); // IUPAC-rate

<16> OH + OH = O {+H2O}          : 6.2d-14*((temp_dp/298.0d0)**2.6)*exp(945.0d0/temp_dp); // k = 6.20E-14 (T/298)^2.6 exp(945/T) 1.48E-12

<17> OH + OH = H2O2              : k3rd_iup_pow(9.0d-31, 3.2d0, 3.9d-11, 0.47d0, 0.43d0); {RH2017: IUPAC}
// Falloff: F=0.42; n=1.23, k(0) = 9.00E-31 (T/300)^-3.2, k(inf) = 3.90E-11 (T/300)^-0.47 6.21E-12

<18> OH + HO2 = PROD {H2O + O2}  : ARRZ(4.8d-11, -250d0); // k = 4.80E-11 exp(250/T) 1.11E-10

//RH-NOTE: Check the following equations, especially for rates!!!!!!
{R34, R35:: Has two channels, one bimolecular, other termolecular. Depends on H2O.}
{the effect of H2O included thru "water factor", see function kwtf()}
{ we could later combine 34 + 35 to one reaction! Fairly sensitive reactions! }
{ R34 HO2 + HO2 = H2O2       : kwtf(2.2d-13, -600.0d0, 1.4d-21, -2200.0d0) ; }
<19> HO2 + HO2 = H2O2 {+O2}      : kwtf(2.2d-13, -600.0d0, 1.4d-21, -2200.0d0) ;
// k = k1 + k2 [M], k1 = 2.20E-13 exp(600/T), k2 = 1.90E-33 exp(980/T) 2.90E-12

{R35 has a bit messy rate: as above, but [M] has to go in}
// { R35 HO2 + HO2 + M = H2O2 {+O2 + M} : kwtf(1.9d-33, -980.0d0, 1.4d-21, -2200.0d0); }
<20> HO2 + HO2 + M = H2O2 {+O2 + M} : kwtf(1.9d-33, -980.0d0, 1.4d-21, -2200.0d0);
//<20> HO2 + HO2 + H2O = H2O2
// k = k1 + k2 [M], k1 = 3.08E-34 exp(2800/T), k2 = 2.66E-54 exp(3180/T) 6.53E-30

<21> H2O2 + hv = 2*OH : photoarr(pd_h2o2); // Photolysis 3.78E-6

<22> H2O2 + OH = HO2 {+H20}      : 1.80E-12; // OLD: ARRZ(2.9d-12,160.0d0); // k = 1.80E-12 1.80E-12

<23> H2O2 + O = OH + HO2         : ARRZ(1.4d-12, 2000.0d0); // k = 1.40E-12 exp(-2000/T) 1.70E-15

<24> NO + NO + O2 = 2*NO2        : ARRZ(4.25d-39,-663.5d0); // k = 4.25E-39 exp(664/T) 3.95E-38

<25> NO + HO2 = OH + NO2         : ARRZ(3.45d-12,-270.0d0); // k = 3.45E-12 exp(270/T) 8.54E-12

<26> NO2 + O3 = NO3              : ARRZ(1.40d-13,2470.0d0); //k = 1.40E-13 exp(-2470/T) 3.52E-17

<27> NO3 + hv = NO2 + O          : photoarr(pd_no3_no2_o); // Photolysis 1.56E-1

<28> NO3 + hv = NO {+O2}         : photoarr(pd_no3_no_o2); // Photolysis 1.98E-2

<29> NO3 + NO = 2*NO2            : ARRZ(1.8d-11,-110.0d0); // k = 1.80E-11 exp(110/T) 2.60E-11

{30: JPL notes that this reaction is not "firmly established", maybe rather thru N2O5. IUPAC doesn't list}
<30> NO3 + NO2 = NO + NO2        : ARRZ(4.5d-14,1260.0d0); // k = 4.50E-14 exp(-1260/T) 6.56E-16

<31> NO3 + OH = HO2 + NO2        : 2.0d-11; // k = 2.00E-11 2.00E-11

// RH NOTE: CB05: product is only HNO3: Should also produce OH+NO2 which should be dominant. Using FinROSE branching 0.85 and 0.15. 
// 32: NO3 + HO2 = 0.85 OH + 0.85 NO2 + 0.15*HNO3 {+O2} : 4.0e-12 ; {RH2017: IUPAC}
<32> NO3 + HO2 = OH + NO2 {+O2}  :  4.0e-12; // k = 4.00E-12 4.00E-12

<33> NO3 + NO3 = 2*NO2 {+O2}     : ARRZ(8.5d-13, 2450d0); // k = 8.50E-13 exp(-2450/T) 2.28E-16

<34> NO3 + NO2 = N2O5            :  k3rd_iup_pow(3.6d-30, 4.1d0, 1.9d-12, -0.2d0, 0.35d0);
// Falloff: F=0.35; n=1.33, k(0) = 3.60E-30 (T/300)^-4.1, k(inf) = 1.90E-12 (T/300)^0.2 1.24E-12

<35> N2O5 = NO3 + NO2 {+M}       : k3rd_iup_exp(1.3d-3, 3.5d0, 11000.0d0, 9.7d14, -0.1d0, 11080.0d0,0.35d0);
// Falloff: F=0.35; n=1.33, k(0) = 1.30E-3 (T/300)^-3.5 exp(-11000/T), k(inf) = 9.70E+14 (T/300)^0.1 exp(-11080/T) 4.46E-2

<36> N2O5 + hv = NO2 + NO3       : photoarr(pd_n2o5); // Photolysis 2.52E-5

<37> N2O5 + H2O = 2*HNO3         : 1.0E-22; // k = 1.00E-22 1.00E-22

<38> NO + OH {+ M} = HONO        : k3rd_iup_pow(7.4d-31, 2.4d0, 3.3d-11, 0.3d0, 0.81d0);
// Falloff: F=0.81; n=0.87, k(0) = 7.40E-31 (T/300)^-2.4, k(inf) = 3.30E-11 (T/300)^-0.3 9.77E-12

<39> HONO + hv = NO + OH          : photoarr(pd_hono); // Photolysis 1.04E-3

<40> HONO + OH = NO2 {+H2O}      : ARRZ(2.5d-12,-260.0d0); // k = 2.50E-12 exp(260/T) 5.98E-12

<41> NO2 + OH {+ M} = HNO3 {+M}  : k3rd_iup_pow(3.2d-30, 4.5d0, 3.0d-11, 0.0d0, 0.41d0);  {RH2017: IUPAC}
// Falloff: F=0.6; n=1, k(0) = 1.80E-30 (T/300)^-3, k(inf) = 2.80E-11 1.06E-11

<42> NO2 + OH + H2O = HNO3 + H2O : 1.10E-30; // k = 1.10E-30 1.10E-30

<43> HNO3 + OH  {+ M} = NO3 {+H20+M} : ksum(2.4d-14, -460.0d0, 6.5d-34, -1335.0d0, 2.7d-17, -2199.0d0);
// k = k1 + k3 [M] / (1 + k3 [M] / k2)
// k1 = 2.40E-14 exp(460/T)
// k2 = 2.70E-17 exp(2199/T)
// k3 = 6.50E-34 exp(1335/T) 1.54E-13

<44> HNO3 + hv = OH + NO2        : photoarr(pd_hno3); // Photolysis 2.54E-7

<45> NO2 + HO2 {+ M} = PNA {+M}  : k3rd_iup_pow(1.4d-31, 3.1d0, 4.0d-12, 0.0d0, 0.4d0);
// Falloff: F=0.4; n=1.26, k(0) = 1.40E-31 (T/300)^-3.1, k(inf) = 4.00E-12 7.50E-13

<46> PNA {+ M} = HO2 + NO2 {+ M} : k3rd_iup_exp(4.1d-5, 0.0d0, 10650.0d0, 6.0d15, 0.0d0, 11170.0d0, 0.4d0);
// Falloff: F=0.4; n=1.26, k(0) = 4.10E-5 exp(-10650/T), k(inf) = 6.00E+15 exp(-11170/T) 6.20E-2

// <47> PNA = 0.59 HO2 + 0.59 NO2 + 0.41 OH + 0.41 NO3 Photolysis 2.36E-6
<47a> PNA + hv = HO2 + NO2       : photoarr(pd_ho2no2) ;
<47b> PNA + hv = OH + NO3        : photoarr(pd_ho2no2_oh_no3) ;

<48> PNA + OH = NO2              : ARRZ(3.2d-13,-690.0d0); // k = 3.20E-13 exp(690/T) 3.24E-12

<49> H2 + OH = HO2             : ARRZ(7.7d-12, 2100d0); // k = 7.70E-12 exp(-2100/T) 6.70E-15  RH-NOTE: here assumed H+O2->HO2
//<49> H2 + OH = H {+H2O}          : ARRZ(7.7d-12, 2100d0); // k = 7.70E-12 exp(-2100/T) 6.70E-15  RH-NOTE: here H explicitely

//RH-NOTE: CHECK rate!!
<50> CO + OH = HO2 {+CO2}        : 1.5E-13 + k3rd_jpl_pow(5.9d-33, 1.0d0, 1.1d-12, -1.3d0);
// k = k1 + k2 [M], k1 = 1.44E-13, k2 = 3.43E-33  2.28E-13

