#DEFVAR
    NO          = N + O ;       {nitric oxide}
    NO2         = N + 2O ;      {nitrogen dioxide}
    NO3         = N + 3O ;      {nitrogen trioxide}
    N2O5        = 2N + 5O ;     {dinitrogen pentoxide}
    HONO        = H + 2O + N ;  {nitrous acid}
    HNO3        = H + N + 3O ;  {nitric acid}
    PNA         = H + 4 O + N ; {HO2NO2 peroxynitric acid}
    O1D         = O ;           {oxygen atomic first singlet state}
    O           = O ;           {oxygen atomic ground state (3P)}
    OH          = O + H ;       {hydroxyl radical}
    O3          = 3O ;          {ozone}
    HO2         = H + 2O ;      {perhydroxyl radical}
    H2O2        = 2H + 2O ;     {hydrogen peroxide}
    HCHO        = C + 2H + O ;  {formalydehyde}
    ALD2        = IGNORE ;      {acetaldehyde}
    C2O3        = 2C + 3H + 3O ; {CH3C(O)OO peroxyacyl radical}
    PAN         = 2C + 3H + 5O + N ; {CH3C(O)OONO2, peroxyacyl nitrate}
    PAR7        = IGNORE ;      {parafin carbon bond}
    ROR7        = IGNORE ;      {secondary organic oxy radical}
    OLE7        = IGNORE ;      {olefinic carbon bond}
    ETH         = 2C + 4H ;     {CH2=CH2 ethene}
    TOL         = 7C + 8H ;     {C6H5-CH3 toluene}
    CRES        = IGNORE ;      {cresol and h.m.w. phenols}
    TO2         = IGNORE ;      {toluene-hydroxyl radical adduct}
    CRO         = IGNORE ;      {methylphenoxy radical}
    OPEN        = IGNORE ;      {h.m.w. aromatic oxidation ring fragment}
    XYL         = 8C + 10H ;    {C6H4-(CH3)2 xylene}
    MGLY        = 3C + 4H + 2O ; {CH3C(O)C(O)H methylglyoxal}
    C5H8        = IGNORE ;      {isoprene}
    XO2         = IGNORE ;      {NO to NO2 conversion from alkylperoxy (RO2) radical}
    XO2N        = IGNORE ;      {NO to organic nitrate conversion from RO2 radical}
    CO          = C + O ;       {carbon monoxide}
//    N2O         = 2N + O ;
    H2Op        = IGNORE;
    Cl          = Cl ;
    ClO         = Cl + O ;
    Cl2         = 2Cl ;
    MEOH        = C + 4H + O;   {methanol}
    ETOH        = 2C + 6H + O;  {ethanol}
    MEO2        = C + 3H + 2O;  {methylperoxy radical}
    MEPX        = C + 4H + 2O;  {methylhydroperoxide}
    ALDX        = IGNORE ;      {propionaldehyde and high molecular weight aldehydes}
    ROOH        = IGNORE ;      {higher organic peroxide}
//    NTR         = IGNORE ;      {organic nitrate RNO3}
    FACD        = C + 2H + 2O;  {formic acid}
    AACD        = 2C + 4H + 2O; {acetic and higher caboxylic acids}
    PACD        = IGNORE ;      {peroxyacetic and higher peroxycaboxylic acids} 
    ETHA        = 2C + 6H;      {ethane}
//    HCO3        = C + 3O + H;
    CXO3        = IGNORE ;      {C3 and higher acylperoxy radicals}
    PANX        = IGNORE ;      {C3 and higher peroxyacyl nitrates}
    IOLE        = IGNORE ;      {internal olefin carbon bond (R-C=C-R)} 
    ISPD        = IGNORE ;      {isoprene product (lumped methacrolein, methyl vinyl ketone, etc)}
    SESQ        = IGNORE ;      {sequiterpenes}
    BENZENE     = 6C + 6H;      {benzene}
    FMCL        = C + O + H + Cl; {Formyl chloride}
    C5H8_2      = IGNORE;       {monoterpenes}
//Additional CBM7 species:
    APO2        = IGNORE;       {Peroxy radical from OH addition to α-pinene}
    BZO2        = IGNORE;       {Peroxy radical from OH addition to benzene}
    EPX2        = IGNORE;       {Peroxy radical from EPOX reaction with OH}
    ISO2        = IGNORE;       {Peroxy radical from OH addition to isoprene}
    OPO3        = IGNORE;       {Peroxyacyl radical from OPEN}
    RO2         = IGNORE;       {Operator to approximate total peroxy radical cnc}
    TPO2        = IGNORE;       {Peroxy radical from OH addition to TERP}
    SQO2        = IGNORE;       {Peroxy radical from OH addition to SQT}
    XLO2        = IGNORE;       {Peroxy radical from OH addition to XYL}
    XO2H        = IGNORE;       {NO to NO2 conversion (XO2) accompanied by HO2 production}
    ACET        = IGNORE;       {Acetone}
    APIN        = IGNORE;       {α-Pinene}
    CAT1        = IGNORE;       {Methyl-catechols} 
    CRON        = IGNORE;       {Nitro-cresols}
    EPOX        = IGNORE;       {Epoxide formed from ISPX reaction with OH}
    ETHY        = 2C + 2H;      {Ethyne}
    GLY         = IGNORE;       {Glyoxal}
    GLYD        = IGNORE;       {Glycolaldehyde}
    HACT        = IGNORE;       {Hydroxyacetone}
    HPLD        = IGNORE;       {hydroperoxyaldehyde}
    ISPX        = IGNORE;       {Hydroperoxides from ISO2 reaction with HO2}
    KET7        = IGNORE;       {Ketone carbon bond (C=O)}
    OPAN        = IGNORE;       {Peroxyacyl nitrate (PAN compound) from OPO3}
    PRPA        = 3C + 8H;      {Propane}
    SO2         = S + 2O;       {Sulfur dioxide}
//    SULF        = S + 4O + 2H;   {Sulfuric acid (gaseous)}
    H2SO4       = S + 4O + 2H;   {Sulfuric acid (gaseous)}
    XOPN        = IGNORE;       {Aromatic ring opening product (unsaturated dicarbonyl)}
    ARPX        = IGNORE;       {Aromatic peroxide from BZO2, TO2 and XLO2}
    NTR1        = IGNORE;       {Simple organic nitrates}
    NTR2        = IGNORE;       {Multi-functional organic nitrates}
    ECH4        = IGNORE;       {Emitted methane (to enable tracking seperate from CH4)}
    XPRP        = IGNORE;       {Operator for organic nitrates from PRPA}
    XPAR7       = IGNORE;       {Operator for organic nitrates from PAR}
    I2 		= 2I;           {Molecular iodine}
    I           = I;            {Iodine atom}
    IO          = I + O;        {Iodine monoxide}
    OIO         = I + 2O;       {Iodinedioxide}
    I2O2        = 2I + 2O;      {Diiodine dioxide}
    IXOY        = IGNORE;       {Condensable iodine oxides}
    HOI         = I + O + H;    {Hypoiodous acid}
    INO3        = I + N + 3O;   {Iodine nitrate}
    DMS         = 2C+6H+S;      {Dimethyl sulfide}
    INTR        = IGNORE;       {Organic nitrates from ISO2 reaction with NO}

