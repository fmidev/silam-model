{Bromine chemistry. Added August 2017 by R.H.}
{FR Br01:} Br + O3 = BrO + O2            :  ARRZ(1.7d-11, 800d0) ; {IUPAC}
{FR Br02:} BrO + O = Br + O2             :  ARRZ(1.9d-11, -230d0) ; {IUPAC}
{FR Br03:} BrO + NO = NO2 + Br           :  ARRZ(8.7d-12, -260d0) ; {IUPAC}
{FR Br04:} BrO + ClO = Br + OClO         :  ARRZ(1.6d-12, -430d0) ; {IUPAC}
{FR Br05:} BrO + ClO = Br + ClO2         :  ARRZ(2.9d-12, -220d0) ; {IUPAC} {RH2020: Corrected the product to ClOO}
{FR Br06:} BrO + ClO = BrCl + O2         :  ARRZ(5.8d-13, -170d0) ; {IUPAC}
{FR Br07a:} BrO + BrO = Br + Br + O2     :  2.7E-12 ; {IUPAC}
{   Br07b:} BrO + BrO = Br2 + O2         :  ARRZ(2.9d-14, -840d0) ; {IUPAC}
{FR Br08:} Br + HO2 = HBr + O2           :  ARRZ(7.7d-12, 450d0) ; {IUPAC}
{FR Br09:} Br + OClO = BrO + ClO         :  ARRZ(2.7d-11, 1300d0) ; {IUPAC}
{FR Br10:} Br + HCHO {+O2} = HBr + CO + HO2 :  ARRZ(1.7d-11, 800d0) ; {JPL}  {IUPAC: ARRZ(7.7d-12,580d0)} {11Jan2018: Changed HCO+O2->CO+HO2}
{FR Br11:} OH + HBr = H2O + Br           :  ARRZ(6.7d-12, -155d0) ; {IUPAC}
{FR Br12:} BrO + NO2 {+M} = BrONO2 {+M}  :  k3rd_iup_pow(4.7d-31, 3.1d0, 1.8d-11, 0.0d0, 0.40d0) ; {IUPAC}
{   Br25:} Br + NO2 {+M} = BrNO2 {+M}    :  k3rd_iup_pow(4.2d-31, 2.4d0, 2.7d-11, 0.0d0, 0.55d0) ; {IUPAC} //RH: Added 3May2021
// BrO + HO2 has a minor channel that produces HBr+O3 in addition to HOBr+O2. See, e.g. Chartrand and McConnell, GRL1998. 20May2020 by R.H.: Put 2 percent to minor channel.
{FR Br13:} BrO + HO2 = 0.98*HOBr + 0.98*O2 + 0.02*HBr + 0.02*O3    :  ARRZ(4.5d-12, -500d0) ; {IUPAC}
//{FR Br13:} BrO + HO2 = HOBr + O2         :  ARRZ(4.5d-12, -500d0) ; {IUPAC} {Rate for HBr+O3 products is close to zero}
//{FR Br14:} HBr + O1D = 0.6 Br + 0.6 OH + 0.2 HBr + 0.2 O + 0.2 BrO + 0.2 HO2 :  1.5E-10 ; {JPL} //RH NOTE: here assumed H+O2->HO2 
{FR Br14:} HBr + O1D = 0.6 Br + 0.6 OH + 0.2 HBr + 0.2 O + 0.2 BrO + 0.2 H :  1.5E-10 ; {JPL}     //RH NOTE: here H explicitely
// {Br15&16: result Br+HO2 and HBr+O2 (maximum branching of 0.03)}
{FR Br15and16:} OH + BrO = 0.97 Br + 0.97 HO2 + 0.03 HBr + 0.03 O2  :  ARRZ(1.8d-11, -250d0) ; {RH2020: Updated value and put 3% to HBr branch, IUPAC}
//{FR Br15and16:} OH + BrO = 0.98 Br + 0.98 HO2 + 0.02 HBr + 0.02 O2  :  ARRZ(1.7d-11, -250d0) ; {IUPAC}
{FR Br17:} HBr + O = Br + OH             :  ARRZ(5.8d-12, 1500d0) ; {JPL}
{FR Br18:} HOBr + O = BrO + OH           :  ARRZ(1.2d-10, 430d0) ; {IUPAC}

{Bromine photolysis reactions. Added August 2017 by R.H.}
//{FR Br19:} BrONO2 + hv = BrO + NO2       :  photoarr(pd_brono2) ;
//{Photolysis product Br+NO3 dominant! Increases ozone depletion! Using JPL 15-10 (2015) mean quantum yields 0.85 (NO3) and 0.15 (NO2)!}
{FR Br19:} BrONO2 + hv = 0.15 BrO + 0.15 NO2 + 0.85 Br + 0.85 NO3 :  photoarr(pd_brono2) ;
{FR Br20:} BrCl + hv = Br + Cl           :  photoarr(pd_brcl) ;
{FR Br21:} HOBr + hv = Br + OH           :  photoarr(pd_hobr) ;
{FR Br22:} BrO + hv = Br + O             :  photoarr(pd_bro) ;
{Additional two reactions needed to break Br2 and BrNO2 from heterogeneous reactions 11-13. Added Oct2017. Rates NEED better values!!}
{Br23:} Br2 + hv = 2 Br                 :  photoarr(pd_br2) ; {rate=0.0437*cos_theta**0.0369*exp(-0.2606/cos_theta), Kanaya et al., Atm. Env. 37, 2463 (2003)}
{Br24:} BrNO2 + hv = Br + NO2           :  photoarr(pd_brno2) ; {tau is order of minute: Roberts at al., Atmos. Chem. Phys. 14, 11201 (2014)}

// Adding the following photolysis of ClO does not seem to change anything. Only ClO amount is slightly decreased (less than 1 percent)
ClO + hv      = Cl + O                 : photoarr(pd_clo) ;  {25km value from Table B.4 on page 600 on Jacobson's book}
// Adding the remaining FinROSE reactions that are still missing. 
//H2O + hv      = OH + HO2               : photoarr(pd_h2o) ;                                 //RH NOTE: here assumed H+O2->HO2 
H2O + hv      = OH + H                 : photoarr(pd_h2o) ;                                   //RH NOTE: here H explicitely 
//CH4 + hv      = HO2 + MEO2             : photoarr(pd_ch4) ; {For CB05: CH3-> CH3O2 = MEO2}  //RH NOTE: here assumed H+O2->HO2
CH4 + hv      = H + MEO2               : photoarr(pd_ch4) ; {For CB05: CH3-> CH3O2 = MEO2}    //RH NOTE: here H explicitely 
CO2 + hv      = CO + O                 : photoarr(pd_co2) ;
NO  + hv      = N + O                  : photoarr(pd_no) ;
//M + hv       = 2 N                    : 0.78*photoarr(pd_n2) ; {Photolysis of N2 is only effective much above 60km. Not needed. Requires special phototable!}
//SO2 + hv {+O2}= SO2 + 2 O               : photoarr(pd_so2) ; {Reaction of resulting SO (from photolysis) with O2 is assumed to be immediate. No other brances.}
//HO2 + hv      = OH + O                 : photoarr(pd_ho2) ; {Reaction of resulting SO (from photolysis) with O2 is assumed to be immediate. No other brances.}

{IUPAC: Reaction CH4+O1D -> 1: CH3+OH, 2: CH3O or CH2OH+H, 3: HCHO+H2, with branching of 0.70, 0.23, and 0.05, respectively.}
{Here we assume products of branch 1 only.}
CH4 + O1D     = OH + MEO2              : 1.5d-10 ; {IUPAC} {For CB05: CH3-> CH3O2 = MEO2}
N + NO        = O {+N2}                : ARRZ(2.1d-11, -100d0) ; {JPL}
N + O2        = NO + O                 : ARRZ(1.5d-11, 3600d0) ; {JPL}
N + NO2       = N2O + O                : ARRZ(5.8d-12, -220d0) ; {JPL}
// N + OH        = NO + H                 : ARRZ(3.8d-11, -85d0) ; {Atkinson, R. et al., J. Phys. Chem. Ref. Data, 18(3), 881-1097 (1989).}
// Remaining FinROSE equations related to atomic H reactions:
H + O2 {+M}   = HO2 {+M}               : k3rd_iup_pow(4.3d-32, 1.2d0, 9.5d-11, -0.44d0, 0.5d0) ; {IUPAC}
H + O3        = OH + O2                : ARRZ(1.4d-10, 470d0) ; {JPL}
H + HO2       = 1.8 OH {+ 0.07 H2 +0.07 O2 + 0.03 H2O} + 0.03 O  : 8.0d-11 ; {IUPAC}
H + NO2       = OH + NO                : ARRZ(4.0d-10, 340d0) ; {JPL}

{Additional reaction and photolysis reactions related to chloro/bromocarbons and CFCs.}
{As for R85, for methyl cloride/bromide continue analogously to CH4 oxidation: CH3-> CH3O2-> CH3O+XO2 (+O2)-> HCHO+HO2+XO2}
// Methyl chloride:
// CH3Cl + hv    = Cl + HCHO + HO2 + XO2  :  photoarr(pd_ch3cl) ;
CH3Cl + hv    = Cl + MEO2                 :  photoarr(pd_ch3cl) ; {For CB05: CH3 -> CH3O2 = MEO2}
// The followings reactions for oxidation of methyl chloride is obtained from book edited by Ralf Kappmann:
// Volatile Organic Compounds in the Atmosphere by Blackwell Publishing.
// CH3Cl + OH      = CH2Cl {+H2O}         : ARRZ(2.1d-12,1210d0) ; {IUPAC}
// CH2Cl + O2 {+M} = CH2ClO2 {+M}         : k3rd_jpl_pow(1.9d-30, 3.2d0, 2.9d-12, 1.2d0) ; {JPL}
// CH2ClO2 + NO    = CH2ClO + NO2         : ARRZ(7.0d-12,-300d0) ; {JPL} {NOTE: Reaction rate is approximate!}
// CH2ClO + O2     = FMCL + HO2           : 6.0d-14 ; {JPL}
// FMCL + hv       = {HCO+Cl->} CO + HO2 + Cl : photoarr(pd_fmcl); ; {NOTE: Reacted HCO+O2 -> CO+HO2} 
// Simplify: Assume quick chainreaction of CH2Cl with O2 -> NO -> O2. NO to NO2 transformation using XO2. NOTE: CB05 has FMCL!}
CH3Cl + OH      = FMCL + HO2 + XO2 {+H2O}  : ARRZ(2.1d-12,1210d0) ; {IUPAC}  
// Reaction CH3Cl + Cl -> CH2Cl + HCl proceeds in a similar way. By simplifying.
CH3Cl + Cl      = FMCL + HO2 + HCl + XO2   : ARRZ(1.8d-11,1081d0) ; {IUPAC}

// Methyl bromide:
// CH3Br + hv    = Br + HCHO + HO2 + XO2  :  photoarr(pd_ch3br) ;
CH3Br + hv    = Br + MEO2                 :  photoarr(pd_ch3br) ; {For CB05: CH3 -> CH3O2 = MEO2}
// Reaction with OH should be most important removal process in troposphere. Finlayson-Pitts & Pitts, Book, p. 702-703, R51-55.}
// CH3Br + OH    = CH2Br {+ H2O}             : ARRZ(1.7d-12,1215d0) ; {IUPAC}
// Eskola, Phys. Chem. Chem. Phys., 2006,8, 1416-1424 : k(CH2Br + O2+ He)=(1.2*e-30*(T/300)^(-4.8) cm6 s(-1)
// CH2Br + O2 {+M} = CH2BrO2                 : k0_pow(1.2d-30, 4.8d0) ; 
// Assuming fast decomposition of CH2BrO -> HCHO+Br (JPL already does this, and gives the following rate):
// CH2BrO2 + NO = HCHO + Br + NO2            : ARRZ(4.0d-12,-300d0) ; {JPL} {NOTE: Rate is estimate!}
// Simplify: As methyl chloride, assume fast reaction of the following reactions. Use XO2 to convert NO to NO2.
CH3Br + OH      = Br + HCHO + XO2 {+H2O}     : ARRZ(1.7d-12,1215d0) ; {IUPAC}

// CFCs typically release several Chlorine atoms with sequence of reactions (starting with photolysis reaction that releases one Cl),
// but here we take a more simple model and release the Cl atoms at once. For some of the species we have described the sequence in
// the commented lines (below the simple model). Oxidation by OH is included for species where it is relevant.
// CFC-11:
CCl3F + hv    = 3 Cl {+CF}             :  photoarr(pd_cfc11) ;
// CCl3F + hv   = Cl + CCl2F              :  photoarr(pd_cfc11) ;
// CCl2F + O2 {+M} = CCl2FO2 {+M}         :  k3rd_jpl_pow(5.0d-30, 4.0d0, 6.0d-12, 1.0d0) ; {JPL}
// possibly add also reaction of CCl2FO2 with NO2 and the reversed reaction, together with photolysis. 
// CCl2FO2 + NO = CClFO + NO2 + Cl        :  ARRZ(4.5d-12, -350d0) ; {JPL}  
// CClFO + hv   = CFO + Cl                :  photoarr(pd_cclfo) ; {phodis has this in extended LUT table. Other products: CO+F+Cl, ClCO+F, CFCl+O}
// CCl3F + O1D  = 0.79 ClO + 0.79 CCl2F + 0.21 O + 0.21 CCl3F : 2.3d-10 ; {IUPAC}
// START: Not done for CFC-11:
// First try to combine the above, simplifying by assuming fast reaction of CCl2F with O2 and ignoring the reaction with NO2. Assuming CClFO+hv-> CO+F+Cl (final products)
// CCl3F + O1D  = 0.79 ClO + 0.79 CCl2FO2 + 0.21 O + 0.21 CCl3F : 2.3d-10 ; {IUPAC}
// CCl3F + hv   = Cl + CCl2FO2              :  photoarr(pd_cfc11) ;
// CCl2FO2 + NO = CClFO + NO2 + Cl          :  ARRZ(4.5d-12, -350d0) ; {JPL}
// CClFO + hv   = CO + Cl {+F}              :  photoarr(pd_cclfo) ; {phodis has this in extended LUT table.}
// END: Not done for CFC-11:

// CFC-12:
CCl2F2 + hv   = 2 Cl {+CF2}            :  photoarr(pd_cfc12) ;
// CCl2F2 + hv     = Cl + CClF2           :  photoarr(pd_cfc12) ;
// CClF2 + O2 {+M} = CClF2O2 {+M}         :  k3rd_jpl_pow(5.2d-29, 5.6d0, 1.0d-11, 0.8d0) ; {JPL}
// possibly add also reaction of CClF2O2 with NO2 and the reversed reaction, together with photolysis.
// CClF2O2 + NO    = CF2O + Cl + NO2      :  ARRZ(3.8d-12, -400d0) ; {JPL}  {Assumed fast decomposition of CClF2O->CF2O+Cl}
// CF2O + hv       = CFO + F              : photoarr(pd_cf2o) ; {Also may result CO+2F or CF2+O, Only needed if F is taken into account. Phodis has this.}
// CCl2F2 + O1D  = 0.76 ClO + 0.76 CClF2 + 0.24 O + 0.24 CCl2F2 : 1.5d-10 ; {IUPAC}
// START: Not done for CFC-12:
// First try to combine the above, simplifying by assuming fast reaction of CClF2 with O2 and ignoring the reaction with NO2. Assuming CF2O+hv-> CO+2F (final products)
// CCl2F2 + O1D  = 0.76 ClO + 0.76 CClF2O2 + 0.24 O + 0.24 CCl2F2 : 1.5d-10 ; {IUPAC}
// CCl2F2 + hv     = Cl + CClF2O2          :  photoarr(pd_cfc12) ;
// Use equation below: CClF2O2 + NO    = CF2O + NO2 + Cl      :  ARRZ(3.8d-12, -400d0) ; {JPL}
// Use equation below: CF2O + hv       = CO {+ 2*F}           : photoarr(pd_cf2o) ; {Typically COF+F, also may result CO+2F or CF2+O, Only needed if F is taken into account}
// In stead of above two reactions, combine them to:
//CClF2O2 + NO    = CO + NO2 + Cl {+2*F}  :  ARRZ(3.8d-12, -400d0) ; {JPL}   {Here the photolysis of CF2O is assumed to appear immediately.}
// Adding reaction HO2+CClF2O2 -> CF2O+HOCl+O2 (other products CF2ClO2H+O2 and CClFO+HOF+O2 are assumed to not to appear). Also fast photolysis of CF2O assumed to follow
//CClF2O2 + HO2   = HOCl {+O2} + CO {+2*F} : 3.4d-12 ; {IUPAC}
// END: Not done for CFC-12:


// CFC-10:
CCl4 + hv     = 4 Cl {+C}              :  photoarr(pd_ccl4) ;
// CCl4 + hv     = CCl3 + Cl              :  photoarr(pd_ccl4) ;
// CCl3 + O2 {+M} = CCl3O2 {+M}           :  k3rd_jpl_pow(8.0d-31, 6.0d0, 3.5d-12, 1.0d0) ; {JPL}
// CCl3O2 + NO    = CCl2O + NO2 + Cl      :  ARRZ(7.3d-12, -270d0) ; {JPL}
// CCl2O + hv     = CClO + Cl             :  photoarr(pd_ccl2o) ; {phodis has this in extended LUT table. Other products are not realized.} 
// CCl4 + O1D  = 0.79 ClO + 0.79 CCl3 + 0.21 O + 0.21 CCl4 : 3.3d-10 ; {IUPAC}
// START: Not done for CFC-10:
// First try to combine the above, simplifying by assuming fast reaction of CCl3 with O2 and ignoring the reaction with NO2. Assuming CCl2O+hv-> CO+2Cl (final products)
// CCl4 + O1D  = 0.79 ClO + 0.79 CCl3O2 + 0.21 O + 0.21 CCl4 : 3.3d-10 ; {IUPAC}
// CCl4 + hv      = CCl3O2 + Cl            :  photoarr(pd_ccl4) ;
// CCl3O2 + NO    = CCl2O + NO2 + Cl       :  ARRZ(7.3d-12, -270d0) ; {JPL}
// CCl2O + hv     = CO + 2*Cl              :  photoarr(pd_ccl2o) ;
// Adding reaction HO2+CCl3O2 -> COCl2+HOCl+O2 (the other branch CCl3O2H+O2 does not realize)
// CCl3O2 + HO2   = CCl2O + HOCl {+O2}     :  ARRZ(4.7d-13, -710d0) ; {IUPAC}
// END: Not done for CFC-10:

// Methyl chloroform:
CH3CCl3 + hv  = 3 Cl {+CH3C}           :  photoarr(pd_ch3ccl3) ;       {we ignore the CH3C product.}
// CH3CCl3 + hv  = Cl +CH3CCl2            :  photoarr(pd_ch3ccl3) ;
// TODO: Fill in the remaining reactions!
// NOTE: ADDED an extra factor to speed up the decay of MCF by OH reaction
CH3CCl3 + OH  = {CH2CCl3->} 3 Cl {+ H2O}   : ARRZ(1.2d-12,1440d0) * MCF_factor ; {IUPAC}   {Seinfeld & Pandis, Book: ARRZ(1.6d-12,1520d0)}
// TODO Fill in the remaining reactions!
// Following simple model for methyl chloroform:
// Assume the CH2CCl3 resulting from reactions of MCF with OH and Cl to first release Cl and then to produce phosgene (CCl2O, or COCl2) with yield 1
// as listed in Kindler et al JGR1995 (upper limit of phosgene yield with reactions of OH and Cl)
// NOT ACTIVE: CH3CCl3 + OH  =  H2O + Cl + CCl2O   : ARRZ(1.2d-12,1440d0) * MCF_factor ; {IUPAC}
// NOT ACTIVE: CH3CCl3 + Cl  =  HCl + Cl + CCl2O   : ARRZ(3.0d-12,1730d0) ; {IUPAC}

// ***************************************************************************************************
// END: ADDITION OF EQUATIONS FROM CBM42_STRATO: Duplicate chlorine equations (above) are commented below
// ***************************************************************************************************


// ******************************************************************************************
//
// Reactions below are related to SOA:
//
// ******************************************************************************************


//RH NOTE on SA01-SA07: The rate seems to depend only on the second reactant: NO, HO2, or OH.
//{SA01} TOLRO2 + NO = NO + TOLNRXN : ARRZ(2.70d-12,-360.0d0);       {CMAQ_1to4(2.70e-12, 0.0E+00, -360.0);}
//{SA02} TOLRO2 + HO2 = HO2 + TOLHRXN : ARRZ(1.90d-13,-1300.0d0);    {CMAQ_1to4(1.90e-13, 0.0E+00, -1300.0);}
//{SA03} XYLRO2 + NO = NO + XYLNRXN : ARRZ(2.70d-12,-360.0d0);       {CMAQ_1to4(2.70e-12, 0.0E+00, -360.0);}
//{SA04} XYLRO2 + HO2 = HO2 + XYLHRXN : ARRZ(1.90d-13,-1300.0d0);    {CMAQ_1to4(1.90e-13, 0.0E+00, -1300.0);}
//{SA05} BENZENE + OH = OH + 0.764*BENZRO2 : ARRZ(2.47d-12,206.0d0); {CMAQ_1to4(2.47e-12, 0.0E+00, 206.0);}
//{SA06} BENZRO2 + NO = NO + BNZNRXN : ARRZ(2.70d-12,-360.0d0);      {CMAQ_1to4(2.70e-12, 0.0E+00, -360.0);}
//{SA07} BENZRO2 + HO2 = HO2 + BNZHRXN : ARRZ(1.90d-13,-1300.0d0);   {CMAQ_1to4(1.90e-13, 0.0E+00, -1300.0);}
//{SA08} SESQ + O3 = O3 + SESQRXN : 1.16d-14;            {CMAQ_1to4(1.16E-14, 0.0E+00, 0.0E+00);}
//{SA09} SESQ + OH = OH + SESQRXN : 1.97E-10;            {CMAQ_1to4(1.97E-10, 0.0E+00, 0.0E+00);}
//{SA10} SESQ + NO3 = NO3 + SESQRXN : 1.90E-11;          {CMAQ_1to4(1.90E-11, 0.0E+00, 0.0E+00);}



{SOA formation: Using the mass yields by Woody et al ACP2015, scaled by the molar weight of the "precursor" gas to get mass SOA.}
{Compared to previous SILAM CB4_SOA values, the factors are rather consistent, except TOL, which has some differences.}
{Compared with Lane et al. 2008, the difference is much bigger, up to factor 50.}
{NOTE: Reaction rates here should correspond to the same gase phase reaction.}
{NOTE2: reactants are not consumed (except C5H8/C5H8_2 + O) here since the corresponding gas phase reactions (above) already do this.}
{NOTE3: The gas phase reaction could be inserted into these SOA equations in order to reduce the number of equations!} 

{hi NOx}
{Here we can copy the products of the corresponding gas phase reactions R128 and R138 (and diable them above)}  
{90} OH + TOL = OH + TOL
              + 0.001012 AVB1e0 + 0.022816 AVB1e1 + 0.042872 AVB1e2 + 0.063848 AVB1e3          : ARRZ(1.8d-12,-340.0d0) * SOA_b;
{91} OH + XYL = OH + XYL
              + 0.000159 AVB1e0 + 0.020670 AVB1e1 + 0.031800 AVB1e2 + 0.046110 AVB1e3          : 1.51e-11 * SOA_b;
{  } OH + BENZENE = OH + BENZENE
              + 0.000234 AVB1e0 + 0.012870 AVB1e1 + 0.023400 AVB1e2 + 0.033930 AVB1e3          : ARRZ(2.3d-12,190.0d0) * SOA_b; {RH2018: IUPAC}

{Here we can copy the products of the corresponding gas phase reactions R141-R144 (and diable them above)}  
{92}   O + C5H8 =  O {+ C5H8} {Removed since CB7 does not contain this reaction and isoprene must be consumed.}
                + 0.0000204 BVB1e0 + 0.00153 BVB1e1 + 0.00102 BVB1e2                           : 3.60E-11 * SOA_b ;
{93}  OH + C5H8 = OH + C5H8
                + 0.0000204 BVB1e0 + 0.00153 BVB1e1 + 0.00102 BVB1e2                           : ARRZ(2.7d-11,-390.0d0) * SOA_b;
{94}  O3 + C5H8 = O3 + C5H8
                + 0.0000204 BVB1e0 + 0.00153 BVB1e1 + 0.00102 BVB1e2                           : ARRZ(1.05d-14, 2000.0d0) * SOA_b; {RH2018: IUPAC}
{95} NO3 + C5H8 = NO3 + C5H8
                + 0.0000204 BVB1e0 + 0.00153 BVB1e1 + 0.00102 BVB1e2                           : ARRZ(2.95d-12,450.0d0) * SOA_b;   {RH2018: IUPAC}

{If we assume that monoterpene products are included (ifMTprods=1) in reactions R149-R152 we can copy the products here (and disable them above).}
{96}   O + C5H8_2 = O {+ C5H8_2} {Removed since CB7 does not contain this reaction and monoterpene must be consumed.}
                  + 0.001632 BVB1e0 + 0.016524 BVB1e1 + 0.027336 BVB1e2 + 0.068952 BVB1e3      : 3.60E-11 * SOA_b;
{97}  OH + C5H8_2 = OH + C5H8_2
                  + 0.001632 BVB1e0 + 0.016524 BVB1e1 + 0.027336 BVB1e2 + 0.068952 BVB1e3      : ARRZ(4.07d-11,-350.0d0) * SOA_b; {OLD: ARRZ(1.5d-11,-449.0d0) * SOA_b;}
{98}  O3 + C5H8_2 = O3 + C5H8_2
                  + 0.001632 BVB1e0 + 0.016524 BVB1e1 + 0.027336 BVB1e2 + 0.068952 BVB1e3      : ARRZ(4.46d-15,960.0d0) * SOA_b; {OLD: ARRZ(1.2d-15, 821.0d0) * SOA_b;}
{99} NO3 + C5H8_2 = NO3 + C5H8_2
                  + 0.001632 BVB1e0 + 0.016524 BVB1e1 + 0.027336 BVB1e2 + 0.068952 BVB1e3      : 7.00d-12 * SOA_b; {OLD: ARRZ(3.7d-12,-175.0d0) * SOA_b;}

{lo NOx}                       
{Here we can copy the products of the corresponding gas phase reactions R128 and R138 (and diable them above)}  
{100} OH + TOL = OH + TOL
               + 0.001012 AVB1e0 + 0.022816 AVB1e1 + 0.06670 AVB1e2 + 0.041584 AVB1e3          : ARRZ(1.8d-12,-340.0d0) * (1.0-SOA_b);
{101} OH + XYL = OH + XYL
               + 0.007950 AVB1e0 + 0.031800 AVB1e1 + 0.03975 AVB1e2 + 0.055650 AVB1e3          : 1.51e-11 * (1.0-SOA_b);
{   } OH + BENZENE = OH + BENZENE
               + 0.005850 AVB1e0 + 0.017550 AVB1e1 + 0.02925 AVB1e2 + 0.040950 AVB1e3          : ARRZ(2.3d-12,190.0d0) * (1.0-SOA_b); {RH2018: IUPAC}

{Here we can copy the products of the corresponding gas phase reactions R141-R144 (and diable them above)}  
{102}   O + C5H8 = O {+ C5H8} {Removed since CB7 does not contain this reaction and isoprene must be consumed.}
                 + 0.000612 BVB1e0 + 0.00204 BVB1e1 + 0.00102 BVB1e2                           : 3.60E-11 * (1.0-SOA_b);
{103}  OH + C5H8 = OH + C5H8
                 + 0.000612 BVB1e0 + 0.00204 BVB1e1 + 0.00102 BVB1e2                           : ARRZ(2.7d-11,-390.0d0) * (1.0-SOA_b);
{104}  O3 + C5H8 = O3 + C5H8
                 + 0.000612 BVB1e0 + 0.00204 BVB1e1 + 0.00102 BVB1e2                           : ARRZ(1.05d-14, 2000.0d0) * (1.0-SOA_b); {RH2018: IUPAC}
{105} NO3 + C5H8 = NO3 + C5H8
		 + 0.000612 BVB1e0 + 0.00204 BVB1e1 + 0.00102 BVB1e2                           : ARRZ(2.95d-12,450.0d0) * (1.0-SOA_b);   {RH2018: IUPAC}

{If we assume that monoterpene products are included (ifMTprods=1) in reactions R149-R152 we can copy the products here (and disable them above).}
{106}   O + C5H8_2 = O {+ C5H8_2} {Removed since CB7 does not contain this reaction and monoterpene must be consumed.}
                   + 0.014593 BVB1e0 + 0.012485 BVB1e1 + 0.048783 BVB1e2 + 0.08262 BVB1e3      : 3.60E-11 * (1.0-SOA_b);
{107}  OH + C5H8_2 = OH + C5H8_2
                   + 0.014593 BVB1e0 + 0.012485 BVB1e1 + 0.048783 BVB1e2 + 0.08262 BVB1e3      : ARRZ(4.07d-11,-350.0d0) *(1.0-SOA_b); {OLD: ARRZ(1.5d-11,-449.0d0) * (1.0-SOA_b);}
{108}  O3 + C5H8_2 = O3 + C5H8_2
                   + 0.014593 BVB1e0 + 0.012485 BVB1e1 + 0.048783 BVB1e2 + 0.08262 BVB1e3      : ARRZ(4.46d-15,960.0d0) * (1.0-SOA_b); {OLD: ARRZ(1.2d-15, 821.0d0) * (1.0-SOA_b);}
{109} NO3 + C5H8_2 = NO3 + C5H8_2
                   + 0.014593 BVB1e0 + 0.012485 BVB1e1 + 0.048783 BVB1e2 + 0.08262 BVB1e3      : 7.00d-12 * (1.0-SOA_b); {OLD: ARRZ(3.7d-12,-175.0d0) * (1.0-SOA_b);}

//NOTE: Added SESQ in the products since CB7 has them already in gas phase reactions! Rates unified with CB7-rates
//Since Shrivastava's mass yields for both high and low NOx cases are the same one can combine these cases:
{107}  OH + SESQ =  OH + SESQ + 0.0153 BVB1e0 + 0.0306 BVB1e1 + 0.153 BVB1e2 + 0.103836 BVB1e3        : 2.00E-10;
{108}  O3 + SESQ =  O3 + SESQ + 0.0153 BVB1e0 + 0.0306 BVB1e1 + 0.153 BVB1e2 + 0.103836 BVB1e3        : 1.20E-14; 
{109} NO3 + SESQ = NO3 + SESQ + 0.0153 BVB1e0 + 0.0306 BVB1e1 + 0.153 BVB1e2 + 0.103836 BVB1e3        : 1.90E-11;

{SOA aging}
   
{110} OH + AVB1e0 = {OH +} 1.075 AVB0                       : ASOA_aging {4.0E-11} ;
{111} OH + AVB1e1 = {OH +} 1.075 AVB1e0                     : ASOA_aging {4.0E-11} ;
{112} OH + AVB1e2 = {OH +} 1.075 AVB1e1                     : ASOA_aging {4.0E-11} ;
{113} OH + AVB1e3 = {OH +} 1.075 AVB1e2                     : ASOA_aging {4.0E-11} ;
{114} OH + AVB1e4 = {OH +} 1.075 AVB1e3                     : IVOC_aging {4.0E-11} ;
{115} OH + AVB1e5 = {OH +} 1.075 AVB1e4                     : IVOC_aging {4.0E-11} ;
{116} OH + AVB1e6 = {OH +} 1.075 AVB1e5                     : IVOC_aging {4.0E-11} ;
{117} OH + BVB1e0 = {OH +} 1.075 BVB0                       : BSOA_aging {4.0E-11} ;
{118} OH + BVB1e1 = {OH +} 1.075 BVB1e0                     : BSOA_aging {4.0E-11} ;
{119} OH + BVB1e2 = {OH +} 1.075 BVB1e1                     : BSOA_aging {4.0E-11} ;
{120} OH + BVB1e3 = {OH +} 1.075 BVB1e2                     : BSOA_aging {4.0E-11} ;

