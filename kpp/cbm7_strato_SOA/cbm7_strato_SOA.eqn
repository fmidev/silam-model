{jo2} O2 + hv = 2*O : photoarr(pd_o2);


//RH NOTE on CL-reactions: Some of the reactions are new and some overlap with CB42_strato equations!
//Here all these reaction are enabled, and the corresponding equations are disabled below (in strato part).
{CL1} Cl2 + hv = 2*Cl         : photoarr(pd_cl2);                                                                   {Exists in CB42_strato!}
{CL2} HOCl + hv = OH + Cl     : photoarr(pd_hocl);                                                                  {Exists in CB42_strato!}
{CL3} Cl + O3 = ClO : ARRZ(2.8d-11,250d0); {IUPAC2017} {orig CB05 rate ARRZ(2.3d-11,200.0d0);}                      {Exists in CB42_strato!}
//RH NOTE on CL4: Expanded CL4 to CL4a and CL4b since typically produces several products with different Arhenius laws! Product OClO+Cl is in reaction 99!
//{CL4} ClO + ClO = 0.3*Cl2 + 1.4*Cl : 1.63E-14;                                                                    {Exists in CB42_strato!}
{CL4a} ClO + ClO = Cl2 + O2          :  ARRZ(1.0d-12,1590d0) ;
{CL4b} ClO + ClO = Cl + ClO2         :  ARRZ(3.0d-11,2450d0) ; {RH2020: Corrected the product to be Cl+ClO2 and not 2Cl+O2} 
{CL5} ClO + NO = Cl + NO2     : ARRZ(6.2d-12,-295d0) ; {IUPAC2017} {orig CB05 rate: ARRZ(6.4d-12,-290.0d0);}        {Exists in CB42_strato!}
// ClO + HO2 has a minor channel that produces HCl+O3 in addition to HOCl+O2. See, e.g. Chartrand and McConnell, GRL1998. 20May2020 by R.H.: Put 2 percent to minor channel.
{CL6} ClO + HO2 = 0.98*HOCl+0.02*HCl+0.02*O3 : ARRZ(2.2d-12,-340d0) ; {IUPAC2017} {orig CB05 rate: ARRZ(2.7d-12,-220.0d9);}        {Exists in CB42_strato!}
//{CL6} ClO + HO2 = HOCl        : ARRZ(2.2d-12,-340d0) ; {IUPAC2017} {orig CB05 rate: ARRZ(2.7d-12,-220.0d9);}        {Exists in CB42_strato!}
{CL7} OH + FMCL = Cl + CO   : 5.0E-13;                                            {Rate is the upper limit! Assumed ClCO->Cl+CO}       {NEW}
{CL8} FMCL + hv = Cl + CO + HO2 : photoarr(pd_fmcl);                                                         {ADD TO LUT TABLE}        {NEW}
{CL9} Cl + CH4 = HCl + MEO2 : ARRZ(6.6d-12,1240d0);                                         {Exists in CB42_strato, BUT different products!}
//{CL10} Cl + PAR = HCl + 0.87*XO2 + 0.13*XO2N + 0.11*HO2 + 0.06*ALD2 - 0.11*PAR + 0.76*ROR + 0.05*ALDX : 5.0E-11; {CB05 rate}         {NEW}
{CL10} Cl + PAR7 = HCl + 0.87*XO2 + 0.13*XO2N + 0.11*HO2 + 0.06*ALD2 - 2.276*PAR7 + 0.76*ROR7 + 0.05*ALDX : 5.0E-11; {CB05 rate}       {NEW} {NOTE: PAR-tweaked eqn, CB7-value}
//{CL11} Cl + ETHA = HCl + 0.991*ALD2 + 0.991*XO2 + 0.009*XO2N + HO2 : ARRZ(7.05d-11,60d0); {IUPAC2019} {orig: ARRZ(8.3d-11,100.0d0);} {NEW}
{CL11} Cl + ETHA = HCl + 0.991*ALD2 + 0.991*XO2 + 0.009*XO2N + HO2 : ARRZ(7.05d-11,60d0); {IUPAC2019} {orig: ARRZ(8.3d-11,100.0d0);}  {NEW} {NOTE: PAR-tweaked eqn, OK for CB7}
// NOTE on CL12: IUPAC states that 3-body reaction!
{CL12} Cl + ETH {+M} = FMCL + 2*XO2 + HO2 + HCHO : k3rd_iup_pow(1.85d-29, 3.3d0, 6.0d-10, 0.0d0, 0.4d0); {orig 1.07E-10;}              {NEW}
// NOTE on CL13: IUPAC rate for 3-body reaction with propene (Cl+C3H6+M) which is very uncertain at low pressures: 
//{CL13} Cl + OLE {+M} = FMCL + 0.33*ALD2 + 0.67*ALDX + 2*XO2 + HO2 - PAR : k3rd_iup_pow(4.0d-28, 0.0d0, 2.7d-10, 0.0d0, 0.6d0);       {NEW}
{CL13} Cl + OLE7 {+M} = FMCL + 0.33*ALD2 + 0.67*ALDX + 2*XO2 + HO2        : k3rd_iup_pow(4.0d-28, 0.0d0, 2.7d-10, 0.0d0, 0.6d0); {NEW} {NOTE: PAR-tweaked eqn, CB7-value}
//                 Original CB05 rate for CL13: {2.5E-10;}
//{CL14} Cl + IOLE = 0.3*HCl + 0.7*FMCL + 0.45*ALD2 + 0.55*ALDX + 0.3*OLE + 0.3*PAR + 1.7*XO2 + HO2 : 3.5E-10;   {CB05 rate}           {NEW}
{CL14} Cl + IOLE = 0.3*HCl + 0.7*FMCL + 0.45*ALD2 + 0.55*ALDX + 0.3*OLE7 + 1.7*XO2 + HO2 : 3.5E-10;   {CB05 rate}                      {NEW} {NOTE: PAR-tweaked eqn, OK for CB7}
//{CL15} Cl + C5H8 = 0.15*HCl + XO2 + HO2 + 0.85*FMCL + ISPD : 4.3E-10;                                          {CB05 rate}           {NEW}
{CL15} Cl + C5H8 = 0.15*HCl + XO2 + HO2 + 0.85*FMCL + ISPD : 4.3E-10;                              {CB05 rate}                         {NEW} {NOTE: PAR-tweaked eqn, CB7-value}
{CL16} Cl + HCHO = HCl + HO2 + CO : ARRZ(8.1d-11,30d0) ; {JPL/IUPAC} {orig CB05 rate: ARRZ(8.2d-11,34.0d0);}        {Exists in CB42_strato!}
{CL17} Cl + ALD2 = HCl + C2O3   : 8.0E-11;     {IUPAC2019} {Orig CB05 rate: 7.9E-11;}                                                  {NEW}
{CL18} Cl + ALDX = HCl + CXO3   : 1.3E-10;     {IUPAC2019} {Orig CB05 rate: 1.3E-10;}                                                  {NEW}
{CL19} Cl + MEOH = HCl + HO2 + HCHO : ARRZ(7.1d-11,75d0);   {IUPAC2019} {Orig CB05 rate: 5.5E-11;}                                     {NEW}
{CL20} Cl + ETOH = HCl + HO2 + ALD2 : ARRZ(6.0d-11,-155d0); {IUPAC2019} {Orig CB05 rate: ARRZ(8.2d-11,-45.0d0);}                       {NEW}
{CL21} HCl + OH = Cl : ARRZ(1.7d-12,230d0) ; {RH2017: IUPAC} {Orig CB05 rate: ARRZ(6.58d-13,-58.0d0);}              {Exists in CB42_strato!}


// Additional tropospheric Bromine reactions taken from
// Parrella et al ACP 12, 6723 (2010) and Yang et al JGR 110, D23311 (2005)
// Equations already in strato part below are not here, also CHBr3 and CH2Br2 are ignored here.

// Reactions that are both in Parrella et al and Yang et al
// Sign changes for the temperature dependency of TropoBr01 and TropoBr04 made on Feb 23, 2024
{TropoBr01} Br + ALD2 = HBr + C2O3  :  ARRZ(1.3d-11,360d0) ; {Yang2005/Parrella2010}
{TropoBr02} Br + BrONO2 = Br2 + NO3  :  4.9e-11 ; {Parrella2010}
{TropoBr03} Br + NO3 = BrO + NO2     :  1.6e-11 ; {JPL/Parrella2010}
{TropoBr04} Br2 + OH = HOBr + Br     :  ARRZ(2.1d-11,-240d0) ; {JPL/Parrella2010}
// Reactions in Yang et al.
{TropoBr05} Br + ALDX  = HBr + CXO3      :  9.7e-12 ; {Yang2005}
//{TropoBrXX} BrO + MEO2 = HOBr + HCHO     :  4.1e-12 ; {Yang2005} {Original products HOBr + CH2O2. Where does one O go?}
//{TropoBrXX} BrO + MEO2 = Br + HCHO + HO2 :  1.6e-12 ; {Yang2005} {Original products BrOO + CH3O.}
// Assuming that products are like above. Atkinson ACP 8, 4141-4496 (2008): k=5.7e-12 with brancing 0.75 and 0.25.
{TropoBr06} BrO + MEO2 = 0.2 Br + 0.2 HO2 + HCHO + 0.8 HOBr : ARRZ(2.65d-12,-1600.0d0) ; {IUPAC} 
{TropoBr07} BrO + C2O3 = Br + MEO2 {+O2} :  1.7e-12 ; {Yang2005}
// Reactions in Parrella et al. Note also the extremely small rates!
// One could use similar Cl reaction products than for ETHA (CL11) and PAR (CL10) for last two of these. 
//{TropoBrXX} Br + ACET = HBr + ATO2    :  ARRZ(1.66d-10,7000d0) ; {Parrella2010} {CHECK SIGN of 2nd argument}
//{TropoBrXX} Br + ETHA = HBr + C2H5O2  :  ARRZ(2.36d-10,6411d0) ; {Parrella2010} {CHECK SIGN of 2nd argument}
//{TropoBrXX} Br + C3H8 = HBr + C3H7O2  :  ARRZ(8.77d-10,4330d0) ; {Parrella2010} {CHECK SIGN of 2nd argument}


// ***************************************************************************************************
// ADDITION OF EQUATIONS FROM CBM42_STRATO: Duplicate chlorine equations (above) are commented below
// ***************************************************************************************************


{*** Stratospheric reactions ***}
{Equations were copied from cbm42_strato, and duplicates (overlapping with CB05 equations)   }
{were removed. The chlorine CB05 extension equations (above equations CL1-21) are commented. } 

{Currently ignored:}
{ -Carbon chemistry apart from what is in CB05}
{ -Photolysis of NO and atomic N (which is only produced due to NO+hv reaction)}
{ -Atomice H is assumed to react immediatelly with O2 + M}

{Clorine reactions: Rates taken/checked August 2017 from IUPAC, if possible}
// Commented the following Cl+O3 reaction since it already exists in CL-reactions of CB05:
